{
  "name": "india-green-tech",
  "version": "1.0.0",
  "description": "Unified Indian Clean Energy & Grid Intelligence Platform integrating live national grid telemetry, regional renewable forecasting, municipal smart city simulations, residential rooftop solar planning, and precision PV yield engineering.",
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist/server",
    "start": "node dist/server/index.js",
    "preview": "vite preview"
  },
